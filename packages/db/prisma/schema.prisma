generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  agents        Agent[]
  calls         Call[]
  entitlements  Entitlement[]
  memberships   Membership[]
  phoneNumbers  PhoneNumber[]
  subscriptions Subscription[]
  usage         UsageEvent[]
}

model User {
  id          String       @id @default(cuid())
  externalId  String       @unique
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model Membership {
  id        String   @id @default(cuid())
  role      Role
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
}

model Agent {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  status    AgentStatus @default(DRAFT)
  config    Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
}

model Entitlement {
  id       String  @id @default(cuid())
  tenantId String
  key      String
  value    String?
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

model Subscription {
  id         String   @id @default(cuid())
  tenantId   String
  provider   String
  customerId String
  priceId    String?
  status     String
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model UsageEvent {
  id       String   @id @default(cuid())
  tenantId String
  type     String
  amount   Int
  ts       DateTime @default(now())
  meta     Json?
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, ts])
}

/// Telephony call record
model Call {
  id             String       @id @default(cuid())
  tenantId       String
  agentId        String?
  provider       String?
  providerCallId String?
  direction      String
  from           String
  to             String
  status         String
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  durationSec    Int?
  recordingUrl   String?
  costCents      Int?
  meta           Json?
  phoneNumberId  String?
  phoneNumber    PhoneNumber? @relation(fields: [phoneNumberId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  events         CallEvent[]
  transcripts    Transcript[]

  @@index([tenantId, startedAt])
  @@index([provider, providerCallId])
}

model CallEvent {
  id      String   @id @default(cuid())
  callId  String
  type    String
  ts      DateTime @default(now())
  payload Json?
  call    Call     @relation(fields: [callId], references: [id])

  @@index([callId, ts])
}

model Transcript {
  id      String   @id @default(cuid())
  callId  String
  channel String
  text    String
  ts      DateTime @default(now())
  call    Call     @relation(fields: [callId], references: [id])

  @@index([callId, ts])
}

/// Provisioned phone numbers for inbound routing
model PhoneNumber {
  id        String   @id @default(cuid())
  tenantId  String
  e164      String   @unique
  label     String?
  provider  String?
  createdAt DateTime @default(now())
  calls     Call[]
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

enum Role {
  owner
  admin
  operator
  viewer
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}
